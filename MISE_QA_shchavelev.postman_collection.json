    {
      "name": "TC-API-05: Негативный — Не хватает обязательного поля name",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Бэкенд возвращает ошибку клиента при отсутствии обязательного поля name', function () {",
              "    // Проверяем, что сервер вернул ошибку (400 Bad Request или 422 Unprocessable Entity)",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
              "});",
              "",
              "pm.test('Ответ содержит детализацию по отсутствующему полю name', function () {",
              "    var jsonData = pm.response.json();",
              "    var responseString = JSON.stringify(jsonData).toLowerCase();",
              "    pm.expect(responseString).to.include('name');",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
