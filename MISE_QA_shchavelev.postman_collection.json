  "item": [
    {
      "name": "TC-API-01: Успешное бронирование (Happy Path)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус-код должен быть 200 или 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "pm.test('Ответ содержит тело бронирования в формате JSON', function () {",
              "    pm.response.to.be.withBody;",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test('Вложенный объект booking содержит все обязательные поля', function () {",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // Проверяем, что корень содержит объект booking",
              "    pm.expect(jsonData).to.have.property('booking');",
              "    ",
              "    // Проверяем поля внутри объекта booking",
              "    var booking = jsonData.booking;",
              "    pm.expect(booking).to.have.property('id');",
              "    pm.expect(booking).to.have.property('name');",
              "    pm.expect(booking).to.have.property('phone');",
              "    pm.expect(booking).to.have.property('date');",
              "    pm.expect(booking).to.have.property('time');",
              "    pm.expect(booking).to.have.property('guests');",
              "    pm.expect(booking).to.have.property('createdAt');",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ил\",\n  \"phone\": \"89153933308\",\n  \"date\": \"2026-09-01\",\n  \"time\": \"12:00\",\n  \"guests\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/booking",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC-API-02: Позитивный edge case — дата на границе +90 дней",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Статус-код должен быть 200 или 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "pm.test('Бронь успешно создана на запрошенную максимальную дату', function () {",
              "    var jsonData = pm.response.json();",
              "    ",
              "    // Получаем дату, которую мы сами отправили в запросе",
              "    var requestBody = JSON.parse(pm.request.body.raw);",
              "    var expectedDate = requestBody.date;",
              "    ",
              "    // Сверяем с тем, что сохранил бэкенд внутри объекта booking",
              "    pm.expect(jsonData.booking.date).to.eql(expectedDate);",
              "});",
              "",
              "pm.test('Вложенный объект booking содержит все обязательные поля', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('booking');",
              "    ",
              "    var booking = jsonData.booking;",
              "    pm.expect(booking).to.have.property('id');",
              "    pm.expect(booking).to.have.property('name');",
              "    pm.expect(booking).to.have.property('phone');",
              "    pm.expect(booking).to.have.property('date');",
              "    pm.expect(booking).to.have.property('time');",
              "    pm.expect(booking).to.have.property('guests');",
              "    pm.expect(booking).to.have.property('createdAt');",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ilya Shchavelev - QA\",\n  \"phone\": \"+7 (915) 393-33-08\",\n  \"date\": \"2026-11-30\",\n  \"time\": \"22:00\",\n  \"guests\": 12\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/booking",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "booking"
          ]
        }
      },
      "response": []
