    {
      "name": "TC-API-03: Негативный — Короткий телефон (Проверка BUG-04)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Бэкенд должен возвращать 400 Bad Request при невалидном телефоне', function () {",
              "    // Тест упадет, так как сервер возвращает 200, фиксируя баг бэкенда",
              "    pm.expect(pm.response.code).to.eql(400);",
              "});",
              "",
              "pm.test('Ответ содержит сообщение об ошибке валидации', function () {",
              "    var jsonData = pm.response.json();",
              "    // Проверяем, что в ответе есть поле error или message, а не успешный объект booking",
              "    pm.expect(jsonData).to.not.have.property('booking');",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
